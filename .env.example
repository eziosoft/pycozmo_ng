# Cozmo Wi-Fi AP credentials.
# Copy this file to .env (gitignored) and fill in your robot's values.
# Read by start.sh (sourced) and by demo.py (python-dotenv load_dotenv).

COZMO_WIFI_SSID=Cozmo_XXXXXXXX
COZMO_WIFI_PASSWORD=XXX-XXXXX-XXXXXXX

# Optional: robot AP address (defaults to 172.31.1.1 in start.sh).
#COZMO_WIFI_HOST=172.31.1.1
